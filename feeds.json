  "services": {
    "_help": "Self-hosted feed server (server/README.md): rsshub + rssbridge turn X/TikTok/Facebook accounts into feeds; relay re-fetches any feed that blocks GitHub's IP range (Substack, Reddit, ...). Instagram uses the official API (type \"instagram\", secrets IG_USER_ID + IG_ACCESS_TOKEN). Values may use ${ENV_VARS}; set them as GitHub Actions secrets. Any source may list \"fallbacks\".",
    "rsshub": {
      "url": "${FEEDS_SERVER_URL}/rsshub",
      "key": "${RSSHUB_ACCESS_KEY}"
    },
    "rssbridge": {
      "url": "${FEEDS_SERVER_URL}/rss-bridge",
      "basicAuth": "${FEEDS_BASIC_AUTH}"
    },
    "relay": {
      "url": "${FEEDS_SERVER_URL}/relay",
      "key": "${RSSHUB_ACCESS_KEY}"
    }
  },
