# Copy to .env and fill in. Never commit .env.

# Public hostname for the server (point its DNS A record at this machine first).
DOMAIN=feeds.gloriousanchor.com

# Protects RSSHub. Make up a long random string:  openssl rand -hex 24
RSSHUB_ACCESS_KEY=

# Protects RSS-Bridge (HTTP basic auth). Hash with:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=anchor
BASIC_AUTH_HASH=

# --- X / Twitter (RSSHub). Use a throwaway account you are willing to lose.
# Option A: auth_token cookie from a logged-in browser session (recommended).
TWITTER_AUTH_TOKEN=
# Option B: username/password login (more likely to trip X's bot checks).
TWITTER_USERNAME=
TWITTER_PASSWORD=

# --- Instagram (RSSHub). Paste the full Cookie header from a logged-in browser session, or use a login.
IG_COOKIE=
IG_USERNAME=
IG_PASSWORD=
